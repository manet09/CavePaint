# ==========================================
# Frontend (Next.js)
# ==========================================
**/node_modules/
**/.next/
frontend/out/
**/.env*.local
**/.pnpm-debug.log

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
# This catches __pycache__ and compiled files at ANY folder depth
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/

# Python packaging clutter
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/*.egg-info/
.env

# ==========================================
# Workspace Storage
# ==========================================
# Ignores all media assets you generate locally
workspace/
!workspace/.gitkeep

# ==========================================
# Global / OS Overrides
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db